  "components": {
    "schemas": {
      "AuthIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "AuthIn"
      },
      "Conditions": {
        "properties": {
          "modalities": {
            "items": {
              "type": "string",
              "enum": [
                "Presencial",
                "Virtual",
                "Semipresencial"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "title": "Modalities"
          },
          "districts": {
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "type": "array",
            "maxItems": 10,
            "title": "Districts"
          },
          "monthly_budget": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Budget"
          },
          "max_months": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 240.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Months"
          },
          "formation": {
            "type": "string",
            "enum": [
              "cualquiera",
              "tecnica",
              "universitaria"
            ],
            "title": "Formation",
            "default": "cualquiera"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Conditions"
      },
      "FeedbackIn": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Score"
          },
          "comment": {
            "type": "string",
            "maxLength": 500,
            "title": "Comment",
            "default": ""
          },
          "research_consent": {
            "type": "boolean",
            "title": "Research Consent",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "score"
        ],
        "title": "FeedbackIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PairIn": {
        "properties": {
          "career_ids": {
            "items": {
              "type": "integer",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Career Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "career_ids"
        ],
        "title": "PairIn"
      },
      "RecommendationIn": {
        "properties": {
          "career_ids": {
            "items": {
              "type": "integer",
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Career Ids"
          },
          "questionnaire_version": {
            "type": "string",
            "maxLength": 30,
            "title": "Questionnaire Version"
          },
          "responses": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 5.0,
                  "minimum": 1.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "maxProperties": 8,
            "title": "Responses"
          },
          "conditions": {
            "$ref": "#/components/schemas/Conditions"
          },
          "catalog_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "career_ids",
          "questionnaire_version",
          "responses"
        ],
        "title": "RecommendationIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
